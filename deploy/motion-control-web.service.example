# Reference only - not applied automatically. Copy to
# /etc/systemd/system/motion-control-web.service, adjust paths/user, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now motion-control-web.service

[Unit]
Description=motion_control_web (rosbridge + web_video_server + safety gateway)
After=network.target

[Service]
Type=simple
User=shs
WorkingDirectory=/home/shs/colcon_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/shs/colcon_ws/install/setup.bash && ros2 launch motion_control_web motion_control_web.launch.py'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
